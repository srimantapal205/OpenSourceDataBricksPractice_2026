      ]
    },
    {
      "name": "ws_monthly_cost",
      "displayName": "Workspace Monthly Cost",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  finops.gold.gold_workspace_monthly_cost"
      ]
    },
    {
      "name": "audit_unpivot",
      "displayName": "Audit Events by Action (Unpivoted)",
      "queryLines": [
        "SELECT\n",
        "  action_name,\n",
        "  'Total Events' AS metric_type,\n",
        "  event_count AS event_count\n",
        "FROM\n",
        "  finops.gold.vw_audit_by_action\n",
        "UNION ALL\n",
        "SELECT\n",
        "  action_name,\n",
        "  'Failed Events' AS metric_type,\n",
        "  failed_events AS event_count\n",
        "FROM\n",
        "  finops.gold.vw_audit_by_action"
      ]
    },
    {
      "name": "audit_by_action",
      "displayName": "Audit by Action",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  finops.gold.vw_audit_by_action"
      ]
    },
    {
      "name": "audit_daily",
      "displayName": "Daily Audit Events",
      "queryLines": [
        "SELECT\n",
        "  event_date,\n",
        "  action_name,\n",
        "  SUM(event_count) AS event_count\n",
        "FROM\n",
        "  finops.gold.gold_audit_summary\n",
        "GROUP BY\n",
        "  event_date,\n",
        "  action_name\n",
        "ORDER BY\n",
        "  event_date"
      ]
    }
  ],
